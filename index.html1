    <button type="button" class="btn btn-secondary" onclick="closeModal('savedModal')" style="margin-top:12px">إغلاق</button>
  </div>
</div>

<div class="modal-overlay" id="printModal">
  <div class="modal">
    <h2>🖨️ خيارات الطباعة / PDF</h2>
    <div style="margin-bottom:14px">
      <label style="font-size:.9rem;font-weight:700;color:var(--gold-light);display:block;margin-bottom:8px">نوع الطباعة</label>
      <label class="print-option">
        <input type="radio" name="printType" value="full" checked>
        <div><div class="label-text">صفحة لكل استمارة أسرة</div><span class="label-desc">طباعة كاملة لجميع معلومات كل أسرة</span></div>
      </label>
      <label class="print-option">
        <input type="radio" name="printType" value="names">
        <div><div class="label-text">أسماء رب الأسرة فقط</div><span class="label-desc">قائمة بأسماء أرباب الأسر</span></div>
      </label>
      <label class="print-option">
        <input type="radio" name="printType" value="count">
        <div><div class="label-text">حسب عدد الأفراد</div><span class="label-desc">ترتيب حسب عدد أفراد الأسرة</span></div>
      </label>
    </div>
    <div style="margin-bottom:14px">
      <label style="font-size:.9rem;font-weight:700;color:var(--gold-light);display:block;margin-bottom:8px">تصنيفات الطباعة</label>
      <div style="font-size:.8rem;margin-bottom:8px">الموظفون</div>
      <div class="tri-toggle">
        <label><input type="radio" name="printEmployee" value="yes"> نعم</label>
        <label><input type="radio" name="printEmployee" value="no" checked> لا</label>
        <label><input type="radio" name="printEmployee" value="all"> الكل</label>
      </div>
      <div style="font-size:.8rem;margin:10px 0 8px">الطلاب</div>
      <div class="tri-toggle">
        <label><input type="radio" name="printStudent" value="yes"> نعم</label>
        <label><input type="radio" name="printStudent" value="no" checked> لا</label>
        <label><input type="radio" name="printStudent" value="all"> الكل</label>
      </div>
      <div style="font-size:.8rem;margin:10px 0 8px">الكاسبون</div>
      <div class="tri-toggle">
        <label><input type="radio" name="printEarner" value="yes"> نعم</label>
        <label><input type="radio" name="printEarner" value="no" checked> لا</label>
        <label><input type="radio" name="printEarner" value="all"> الكل</label>
      </div>
    </div>
    <button type="button" class="btn btn-primary" onclick="executePrint()">🖨️ طباعة الآن</button>
    <button type="button" class="btn btn-secondary" onclick="closeModal('printModal')" style="background:linear-gradient(135deg,#4b5563,#6b7280)">إلغاء</button>
  </div>
</div>

<div class="toast" id="toast"></div>
<div id="printArea"></div>
<script>
// ====== بيانات عامة ======
var records = [];
try { records = JSON.parse(localStorage.getItem('azhar_records') || '[]'); } catch(e) { records = []; }

var OPT = {
  relation: ['أخرى','ابن','ابنة','حفيد','حفيدة','زوجة ابن','زوج ابنة','اخ','اخت','ابناء الاخوة او الاخوات'],
  occupation: ['أخرى','موظف','طالب','خريج','كاسب','عاطل','تاجر','مستفيد من الرعاية الاجتماعية'],
  education: ['أخرى','بلا','ابتدائية','متوسطة','اعدادية','دبلوم','بكلوريوس','ماجستير','دكتوراه','بروف','علوم دينية'],
  orphanKind: ['أخرى','يتيم الاب','يتيم الام','مفصول الاب','مفصول الام'],
  fatherStatus: ['أخرى','حي','ميت','منفصل','مطلق','ارمل','عازب'],
  motherStatus: ['أخرى','حي','ميت','منفصل','مطلق','ارمل','عازب'],
  marital: ['أخرى','أعزب','متزوج','منفصل','مطلق','أرمل'],
  fatherMarital: ['أخرى','متزوج','مطلق','أرمل','منفصل','أعزب'],
  motherMarital: ['أخرى','متزوجة','مطلقة','أرملة','منفصلة','عزباء'],
  siteTypes: {
    'خزن': ['أخرى','مخزن مواد منزلية','مخزن مواد انشائية','مخزن مواد غذائية','مخزن مواد زراعية','مخزن قطع غيار','مخزن أخشاب','مخزن حديد','مخزن أدوية','مخزن ملابس'],
    'بيع مباشر': ['أخرى','سوق','سوبر ماركت','بقالة','فرن','مخبز','صيدلية','محل ملابس','محل أحذية','محل هواتف','محل صيانة هواتف','محل إلكترونيات','محل قطع غيار','محل خضار وفواكه','لحوم','دواجن','أسماك','حلويات','عصائر','مطعم','كافي','مقهى','مطعم وجبات سريعة','محل أدوات منزلية','محل أدوات صحية','محل دهان','محل زجاج','محل حديد','محل ألمنيوم','محل سيراميك','محل موبايلات','محل قرطاسية','محل لعب أطفال','محل عطورات','محل مستحضرات تجميل','محل هدايا','محل زهور','محل فطائر','محل مثلجات','محل مكسرات','محل بذور','محل طيور','محل حيوانات','محل أسماك زينة'],
    'تقديم خدمات': ['أخرى','خدمات طبية وصحية','عيادة طبية','مختبر تحليلات','صيدلية خدمات','حلاقة','صالون نسائي','صيانة هواتف','صيانة إلكترونيات','صيانة أجهزة كهربائية','صيانة سيارات','غسيل سيارات','تأجير مواد','تأجير عدد انشائية','تأجير سيارات','مكتب عقود بيع وشراء','مكتب محاسبة','مكتب خدمات عامة','مغسلة ملابس','مخيض','تنظيف','نقل أثاث','توصيل'],
    'ادارة او مكتب': ['أخرى','منظمات خيرية','منظمة سياسية او حزبية','مكتب استشارات','مكتب محاماة','مكتب هندسي','مكتب عقاري','مكتب دعاية وإعلان','مكتب سفر وسياحة','مكتب تشغيل','شركة تجارية','شركة مقاولات','شركة استيراد وتصدير','مكتب إداري','مقر نقابة','مقر اتحاد']
  }
};

function updateProgress(){
  var fields = document.querySelectorAll('.container input, .container select, .container textarea');
  var filled = 0;
  for (var i = 0; i < fields.length; i++) { if (fields[i].value) filled++; }
  var pct = fields.length ? (filled / fields.length) * 100 : 0;
  var bar = document.getElementById('progressBar');
  if (bar) bar.style.width = pct + '%';
}

function showToast(msg, type){
  var t = document.getElementById('toast');
  if (!t) return;
  t.textContent = msg;
  t.className = 'toast ' + (type === 'error' ? 'error' : '');
  t.classList.add('show');
  setTimeout(function(){ t.classList.remove('show'); }, 2500);
}

function buildOptions(list, selected){
  var html = '';
  for (var i = 0; i < list.length; i++) {
    var v = list[i];
    html += '<option value="' + v + '"' + (v === selected ? ' selected' : '') + '>' + v + '</option>';
  }
  return html;
}

function getVal(id){ var e = document.getElementById(id); return e ? e.value : ''; }
function setVal(id, v){ var e = document.getElementById(id); if (e) e.value = v || ''; }
function show(id){ var e = document.getElementById(id); if (e) e.classList.remove('hidden'); }
function hide(id){ var e = document.getElementById(id); if (e) e.classList.add('hidden'); }

// ====== الحالة الاجتماعية لرب الأسرة ======
function onHeadMaritalChange(){
  var v = getVal('headMarital');
  if (v === 'متزوج') {
    show('wivesSection');
  } else {
    hide('wivesSection');
    document.getElementById('wivesFields').innerHTML = '';
    document.getElementById('formerWivesFields').innerHTML = '';
    setVal('wivesCount', '0');
    setVal('formerWivesCount', '0');
  }
  updateProgress();
}

// ====== توليد حقول الزوجات ======
function generateWifeFields(){
  var count = parseInt(getVal('wivesCount')) || 0;
  var container = document.getElementById('wivesFields');
  container.innerHTML = '';
  for (var i = 0; i < count; i++) {
    var html = '';
    html += '<div class="member-header"><div class="member-title">💍 الزوجة ' + (i + 1) + '</div><div class="member-number">' + (i + 1) + '</div></div>';
    html += '<div class="field"><label>الاسم الكامل</label><input type="text" class="wife-name" placeholder="اسم الزوجة"></div>';
    html += '<div class="field"><label>اسم الأم</label><input type="text" class="wife-mother" placeholder="اسم الأم"></div>';
    html += '<div class="field"><label>تاريخ التولد</label><input type="date" class="wife-birth"></div>';
    html += '<div class="field"><label>التحصيل الدراسي</label><select class="wife-edu">' + buildOptions(OPT.education, '') + '</select></div>';
    html += '<div class="field"><label>الحالة / المهنة</label><select class="wife-occ">' + buildOptions(OPT.occupation, '') + '</select></div>';
    var d = document.createElement('div');
    d.className = 'wife-member';
    d.innerHTML = html;
    container.appendChild(d);
  }
  updateProgress();
}

// ====== توليد حقول الزوجات السابقات ======
function generateFormerWifeFields(){
  var count = parseInt(getVal('formerWivesCount')) || 0;
  var container = document.getElementById('formerWivesFields');
  container.innerHTML = '';
  for (var i = 0; i < count; i++) {
    var html = '';
    html += '<div class="member-header"><div class="member-title">💔 السابقة ' + (i + 1) + '</div><div class="member-number">' + (i + 1) + '</div></div>';
    html += '<div class="field"><label>الاسم الكامل</label><input type="text" class="former-wife-name" placeholder="الاسم"></div>';
    html += '<div class="field"><label>الحالة</label><select class="former-wife-status"><option>أخرى</option><option>متوفاة</option><option>مطلقة</option><option>منفصلة</option></select></div>';
    var d = document.createElement('div');
    d.className = 'former-wife';
    d.innerHTML = html;
    container.appendChild(d);
  }
  updateProgress();
}

// ====== اليتم لرب الأسرة ======
function onHeadOrphanChange(){
  var v = getVal('headOrphan');
  if (v === 'نعم') show('headOrphanField');
  else hide('headOrphanField');
}// ====== نوع السكن ======
function onHousingTypeChange(){
  var v = getVal('housingType');
  if (v === 'سكني') { show('residentialHousing'); hide('commercialHousing'); }
  else if (v === 'تجاري') { hide('residentialHousing'); show('commercialHousing'); }
  else { hide('residentialHousing'); hide('commercialHousing'); }
  updateProgress();
}

function onCommercialTypeChange(){
  var v = getVal('commercialType');
  if (v === 'مؤجر' || v === 'سرقفلية' || v === 'متجاوز') show('commercialOwnerInfo');
  else hide('commercialOwnerInfo');
  updateProgress();
}

function onSiteTypeChange(){
  var v = getVal('siteType');
  var subEl = document.getElementById('siteSubtype');
  if (!v || v === 'أخرى') { hide('siteSubtypeField'); subEl.innerHTML = ''; return; }
  var list = OPT.siteTypes[v] || ['أخرى'];
  subEl.innerHTML = buildOptions(list, '');
  show('siteSubtypeField');
  updateProgress();
}

// ====== توليد حقول الأفراد ======
function generateFamilyFields(){
  var count = parseInt(getVal('familyCount')) || 0;
  var container = document.getElementById('familyFields');
  container.innerHTML = '';
  for (var i = 0; i < count; i++) {
    var html = '';
    html += '<div class="member-header"><div class="member-title">👤 فرد ' + (i + 1) + '</div><div class="member-number">' + (i + 1) + '</div></div>';
    html += '<div class="field"><label>الاسم الكامل</label><input type="text" class="member-name" placeholder="الاسم"></div>';
    html += '<div class="field"><label>صلة القرابة</label><select class="member-relation">' + buildOptions(OPT.relation, '') + '</select></div>';
    html += '<div class="field"><label>اسم الأم</label><input type="text" class="member-mother" placeholder="اسم الأم"></div>';
    html += '<div class="field"><label>تاريخ التولد</label><input type="date" class="member-birth"></div>';
    html += '<div class="field"><label>التحصيل الدراسي</label><select class="member-edu">' + buildOptions(OPT.education, '') + '</select></div>';
    html += '<div class="field"><label>الحالة / المهنة</label><select class="member-occ">' + buildOptions(OPT.occupation, '') + '</select></div>';
    html += '<div class="field"><label>اليتم</label><select class="member-orphan" onchange="onMemberOrphanChange(this)"><option>لا</option><option>نعم</option></select></div>';
    html += '<div class="field hidden orphan-kind-field"><label>نوع اليتم</label><select class="member-orphan-kind">' + buildOptions(OPT.orphanKind, '') + '</select></div>';
    var d = document.createElement('div');
    d.className = 'family-member';
    d.innerHTML = html;
    container.appendChild(d);
  }
  updateProgress();
}

function onMemberOrphanChange(sel){
  var kindField = sel.closest('.family-member').querySelector('.orphan-kind-field');
  if (sel.value === 'نعم') kindField.classList.remove('hidden');
  else kindField.classList.add('hidden');
}

// ====== جمع بيانات الزوجات ======
function collectWives(){
  var arr = [];
  var els = document.querySelectorAll('#wivesFields .wife-member');
  for (var i = 0; i < els.length; i++) {
    var el = els[i];
    arr.push({
      name: el.querySelector('.wife-name').value,
      motherName: el.querySelector('.wife-mother').value,
      birthDate: el.querySelector('.wife-birth').value,
      education: el.querySelector('.wife-edu').value,
      occupation: el.querySelector('.wife-occ').value
    });
  }
  return arr;
}

function collectFormerWives(){
  var arr = [];
  var els = document.querySelectorAll('#formerWivesFields .former-wife');
  for (var i = 0; i < els.length; i++) {
    var el = els[i];
    arr.push({
      name: el.querySelector('.former-wife-name').value,
      status: el.querySelector('.former-wife-status').value
    });
  }
  return arr;
}

// ====== جمع بيانات الأفراد ======
function collectMembers(){
  var arr = [];
  var els = document.querySelectorAll('#familyFields .family-member');
  for (var i = 0; i < els.length; i++) {
    var el = els[i];
    var orphan = el.querySelector('.member-orphan').value;
    var orphanKind = orphan === 'نعم' ? el.querySelector('.member-orphan-kind').value : '';
    arr.push({
      name: el.querySelector('.member-name').value,
      relation: el.querySelector('.member-relation').value,
      motherName: el.querySelector('.member-mother').value,
      birthDate: el.querySelector('.member-birth').value,
      education: el.querySelector('.member-edu').value,
      occupation: el.querySelector('.member-occ').value,
      orphan: orphan,
      orphanKind: orphanKind
    });
  }
  return arr;
}

// ====== حفظ السجل ======
function saveRecord(silent){
  var gov = getVal('governorate');
  if (!gov) { showToast('الرجاء اختيار المحافظة', 'error'); return null; }

  var headOrphan = getVal('headOrphan');
  var head = {
    name: getVal('headName'),
    marital: getVal('headMarital'),
    motherName: getVal('headMotherName'),
    fatherStatus: getVal('headFatherStatus'),
    motherStatus: getVal('headMotherStatus'),
    birthDate: getVal('headBirthDate'),
    education: getVal('headEducation'),
    occupation: getVal('headOccupation'),
    orphan: headOrphan,
    orphanKind: headOrphan === 'نعم' ? getVal('headOrphanKind') : '',
    cardInfo: getVal('headCardInfo'),
    phone: getVal('phone')
  };

  var record = {
    id: Date.now() + Math.floor(Math.random() * 1000),
    surveyorName: getVal('surveyorName'),
    inventoryStart: getVal('inventoryStart'),
    governorate: gov,
    district: getVal('district'),
    subdistrict: getVal('subdistrict'),
    area: getVal('area'),
    neighborhood: getVal('neighborhood'),
    housingType: getVal('housingType'),
    residentialType: getVal('residentialType'),
    housingCard: getVal('housingCard'),
    rationNumber: getVal('rationNumber'),
    commercialType: getVal('commercialType'),
    ownerName: getVal('ownerName'),
    ownerId: getVal('ownerId'),
    ownerOccupation: getVal('ownerOccupation'),
    tenantName: getVal('tenantName'),
    tenantId: getVal('tenantId'),
    tenantOccupation: getVal('tenantOccupation'),
    siteType: getVal('siteType'),
    siteSubtype: getVal('siteSubtype'),
    head: head,
    wives: collectWives(),
    formerWives: collectFormerWives(),
    familyCount: parseInt(getVal('familyCount')) || 0,
    members: collectMembers(),
    notes: getVal('notes'),
    savedAt: new Date().toLocaleString('ar-IQ')
  };

  records.push(record);
  try { localStorage.setItem('azhar_records', JSON.stringify(records)); } catch(e){}
  try { localStorage.setItem('azhar_surveyor', record.surveyorName); } catch(e){}
  if (!silent) showToast('✅ تم حفظ الاستمارة بنجاح');
  return record;
}

function handleSave(){ saveRecord(false); }

function handleNewFamily(){
  var gov = getVal('governorate');
  if (gov) saveRecord(true);

  var invEl = document.getElementById('inventoryStart');
  var cur = invEl ? invEl.value.trim() : '';
  var next = '';
  if (cur && !isNaN(parseInt(cur))) next = String(parseInt(cur) + 1);
  else if (cur) next = cur;
  if (invEl) invEl.value = next;

  var ids = ['housingCard','rationNumber','headCardInfo','phone','notes','district','subdistrict','area','neighborhood','headName','headMotherName','headBirthDate','ownerName','ownerId','tenantName','tenantId'];
  for (var i = 0; i < ids.length; i++) setVal(ids[i], '');
  setVal('headMarital', '');
  setVal('headEducation', '');
  setVal('headOccupation', '');
  setVal('headFatherStatus', '');
  setVal('headMotherStatus', '');
  setVal('headOrphan', 'لا');
  hide('headOrphanField');
  hide('wivesSection');
  document.getElementById('wivesFields').innerHTML = '';
  document.getElementById('formerWivesFields').innerHTML = '';
  setVal('wivesCount', '0');
  setVal('formerWivesCount', '0');
  setVal('familyCount', '0');
  document.getElementById('familyFields').innerHTML = '';

  showToast('➕ استمارة جديدة — رقم الجرد: ' + (next || '—'));
  window.scrollTo({ top: 0, behavior: 'smooth' });
  updateProgress();
}

function resetAll(){
  if (!confirm('هل تريد مسح كل البيانات والبدء من جديد؟')) return;
  var all = document.querySelectorAll('.container input, .container select, .container textarea');
  for (var i = 0; i < all.length; i++) {
    var el = all[i];
    if (el.tagName === 'SELECT') el.selectedIndex = 0;
    else el.value = '';
  }
  document.getElementById('familyFields').innerHTML = '';
  document.getElementById('wivesFields').innerHTML = '';
  document.getElementById('formerWivesFields').innerHTML = '';
  hide('wivesSection'); hide('headOrphanField'); hide('residentialHousing'); hide('commercialHousing'); hide('commercialOwnerInfo'); hide('siteSubtypeField');
  showToast('🔄 تم المسح الكامل');
  updateProgress();
  }
  // ====== المودالات ======
function openModal(id){ document.getElementById(id).classList.add('active'); }
function closeModal(id){ document.getElementById(id).classList.remove('active'); }

function escapeHtml(s){
  if (s === null || s === undefined) return '';
  return String(s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

// ====== السجلات ======
function openSavedModal(){
  var list = document.getElementById('savedList');
  if (records.length === 0) {
    list.innerHTML = '<p style="text-align:center;opacity:.6;padding:20px">لا توجد سجلات محفوظة</p>';
  } else {
    var html = '';
    for (var i = 0; i < records.length; i++) {
      var r = records[i];
      var name = (r.head && r.head.name) ? r.head.name : 'غير مسمى';
      html += '<div class="saved-item">';
      html += '<div class="info" onclick="loadRecord(' + r.id + ')">';
      html += '<div class="name">' + escapeHtml(name) + '</div>';
      html += '<div class="meta">رقم الجرد: ' + escapeHtml(r.inventoryStart || '—') + ' | ' + escapeHtml(r.governorate) + ' | ' + r.familyCount + ' أفراد</div>';
      html += '</div>';
      html += '<div class="actions">';
      html += '<button type="button" class="icon-btn" onclick="loadRecord(' + r.id + ')">✏️</button>';
      html += '<button type="button" class="icon-btn del" onclick="deleteRecord(' + r.id + ')">🗑️</button>';
      html += '</div></div>';
    }
    list.innerHTML = html;
  }
  openModal('savedModal');
}

function loadRecord(id){
  var r = null;
  for (var i = 0; i < records.length; i++) if (records[i].id === id) r = records[i];
  if (!r) return;
  setVal('surveyorName', r.surveyorName);
  setVal('inventoryStart', r.inventoryStart);
  setVal('governorate', r.governorate);
  setVal('district', r.district);
  setVal('subdistrict', r.subdistrict);
  setVal('area', r.area);
  setVal('neighborhood', r.neighborhood);
  setVal('housingType', r.housingType);
  onHousingTypeChange();
  if (r.housingType === 'سكني') {
    setVal('residentialType', r.residentialType);
    setVal('housingCard', r.housingCard);
    setVal('rationNumber', r.rationNumber);
  } else {
    setVal('commercialType', r.commercialType);
    onCommercialTypeChange();
    setVal('ownerName', r.ownerName);
    setVal('ownerId', r.ownerId);
    setVal('ownerOccupation', r.ownerOccupation);
    setVal('tenantName', r.tenantName);
    setVal('tenantId', r.tenantId);
    setVal('tenantOccupation', r.tenantOccupation);
    setVal('siteType', r.siteType);
    onSiteTypeChange();
    setVal('siteSubtype', r.siteSubtype);
  }
  var h = r.head || {};
  setVal('headName', h.name);
  setVal('headMarital', h.marital);
  onHeadMaritalChange();
  setVal('headMotherName', h.motherName);
  setVal('headFatherStatus', h.fatherStatus);
  setVal('headMotherStatus', h.motherStatus);
  setVal('headBirthDate', h.birthDate);
  setVal('headEducation', h.education);
  setVal('headOccupation', h.occupation);
  setVal('headOrphan', h.orphan || 'لا');
  onHeadOrphanChange();
  setVal('headOrphanKind', h.orphanKind);
  setVal('headCardInfo', h.cardInfo);
  setVal('phone', h.phone);
  if (r.wives && r.wives.length) {
    setVal('wivesCount', r.wives.length);
    generateWifeFields();
    setTimeout(function(){
      var els = document.querySelectorAll('#wivesFields .wife-member');
      for (var i = 0; i < els.length; i++) {
        var w = r.wives[i]; if (!w) continue;
        els[i].querySelector('.wife-name').value = w.name || '';
        els[i].querySelector('.wife-mother').value = w.motherName || '';
        els[i].querySelector('.wife-birth').value = w.birthDate || '';
        els[i].querySelector('.wife-edu').value = w.education || '';
        els[i].querySelector('.wife-occ').value = w.occupation || '';
      }
    }, 100);
  }
  if (r.formerWives && r.formerWives.length) {
    setVal('formerWivesCount', r.formerWives.length);
    generateFormerWifeFields();
    setTimeout(function(){
      var els = document.querySelectorAll('#formerWivesFields .former-wife');
      for (var i = 0; i < els.length; i++) {
        var w = r.formerWives[i]; if (!w) continue;
        els[i].querySelector('.former-wife-name').value = w.name || '';
        els[i].querySelector('.former-wife-status').value = w.status || '';
      }
    }, 100);
  }
  setVal('familyCount', r.familyCount);
  generateFamilyFields();
  setTimeout(function(){
    var els = document.querySelectorAll('#familyFields .family-member');
    for (var i = 0; i < els.length; i++) {
      var m = r.members[i]; if (!m) continue;
      els[i].querySelector('.member-name').value = m.name || '';
      els[i].querySelector('.member-relation').value = m.relation || '';
      els[i].querySelector('.member-mother').value = m.motherName || '';
      els[i].querySelector('.member-birth').value = m.birthDate || '';
      els[i].querySelector('.member-edu').value = m.education || '';
      els[i].querySelector('.member-occ').value = m.occupation || '';
      var orphSel = els[i].querySelector('.member-orphan');
      orphSel.value = m.orphan || 'لا';
      onMemberOrphanChange(orphSel);
      if (m.orphanKind) els[i].querySelector('.member-orphan-kind').value = m.orphanKind;
    }
    updateProgress();
  }, 150);
  setVal('notes', r.notes);
  closeModal('savedModal');
  showToast('📂 تم تحميل السجل');
}

function deleteRecord(id){
  if (!confirm('حذف هذا السجل؟')) return;
  var arr = [];
  for (var i = 0; i < records.length; i++) if (records[i].id !== id) arr.push(records[i]);
  records = arr;
  try { localStorage.setItem('azhar_records', JSON.stringify(records)); } catch(e){}
  openSavedModal();
  showToast('🗑️ تم الحذف');
}

// ====== التصدير والاستيراد ======
function exportData(){
  if (records.length === 0) { showToast('لا توجد سجلات للتصدير', 'error'); return; }
  var blob = new Blob([JSON.stringify(records, null, 2)], { type: 'application/json' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  var d = new Date().toISOString().slice(0, 10);
  a.href = url;
  a.download = 'استمارات-أزهر-' + d + '.json';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast('📤 تم تصدير ' + records.length + ' سجل');
}

function importData(){
  var f = document.getElementById('importFile');
  f.value = '';
  f.onchange = function(e){
    var file = e.target.files[0]; if (!file) return;
    var reader = new FileReader();
    reader.onload = function(ev){
      try {
        var imported = JSON.parse(ev.target.result);
        if (!Array.isArray(imported)) throw new Error('صيغة خاطئة');
        var added = 0;
        for (var i = 0; i < imported.length; i++) {
          var exists = false;
          for (var j = 0; j < records.length; j++) if (records[j].id === imported[i].id) exists = true;
          if (!exists) { records.push(imported[i]); added++; }
        }
        try { localStorage.setItem('azhar_records', JSON.stringify(records)); } catch(err){}
        showToast('📥 تم استيراد ' + added + ' سجل');
        openSavedModal();
      } catch(err) { showToast('خطأ في قراءة الملف', 'error'); }
    };
    reader.readAsText(file);
  };
  f.click();
}

// ====== الطباعة ======
function getCheckedRadio(name){
  var el = document.querySelector('input[name="' + name + '"]:checked');
  return el ? el.value : '';
}

function openPrintModal(){
  if (records.length === 0) { showToast('لا توجد سجلات للطباعة', 'error'); return; }
  openModal('printModal');
}

function executePrint(){
  var printType = getCheckedRadio('printType') || 'full';
  var employeeFilter = getCheckedRadio('printEmployee') || 'no';
  var studentFilter = getCheckedRadio('printStudent') || 'no';
  var earnerFilter = getCheckedRadio('printEarner') || 'no';
  var filtered = records.slice();

  function hasOcc(r, occ){
    if (r.head && r.head.occupation === occ) return true;
    for (var i = 0; i < (r.members || []).length; i++) if (r.members[i].occupation === occ) return true;
    for (var j = 0; j < (r.wives || []).length; j++) if (r.wives[j].occupation === occ) return true;
    return false;
  }
  if (employeeFilter === 'yes') filtered = filtered.filter(function(r){ return hasOcc(r, 'موظف'); });
  if (studentFilter === 'yes') filtered = filtered.filter(function(r){ return hasOcc(r, 'طالب'); });
  if (earnerFilter === 'yes') filtered = filtered.filter(function(r){ return hasOcc(r, 'كاسب'); });
  if (filtered.length === 0) { showToast('لا توجد نتائج مطابقة', 'error'); return; }

  var printArea = document.getElementById('printArea');
  var footerText = 'تم تصميم هذا الموقع تطوعاً بواسطة المهندس أزهر باسم محمد — دعماً للاستقرار المجتمعي 🇮🇶';
  var html = '';

  if (printType === 'names') {
    html += '<div class="print-page"><div class="print-header"><h1>🏛️ استمارة المهندس أزهر الإلكترونية</h1><h2>قائمة أسماء أرباب الأسر</h2></div>';
    html += '<table class="print-table"><thead><tr><th>#</th><th>رقم الجرد</th><th>اسم المختار</th><th>الاسم</th><th>المحافظة</th><th>القضاء</th><th>الهاتف</th><th>عدد الأفراد</th></tr></thead><tbody>';
    for (var i = 0; i < filtered.length; i++) {
      var r = filtered[i];
      var name = (r.head && r.head.name) ? r.head.name : '—';
      var total = (r.familyCount || 0) + (r.wives ? r.wives.length : 0);
      html += '<tr><td>' + (i + 1) + '</td><td>' + escapeHtml(r.inventoryStart || '—') + '</td><td>' + escapeHtml(r.surveyorName || '—') + '</td><td>' + escapeHtml(name) + '</td><td>' + escapeHtml(r.governorate) + '</td><td>' + escapeHtml(r.district || '—') + '</td><td>' + escapeHtml((r.head && r.head.phone) || '—') + '</td><td>' + total + '</td></tr>';
    }
    html += '</tbody></table><div class="print-footer">' + footerText + '</div><div class="print-meta">تاريخ الطباعة: ' + new Date().toLocaleString('ar-IQ') + '</div></div>';
  } else if (printType === 'count') {
    var sorted = filtered.slice().sort(function(a, b){ return (b.familyCount||0) - (a.familyCount||0); });
    html += '<div class="print-page"><div class="print-header"><h1>🏛️ استمارة المهندس أزهر الإلكترونية</h1><h2>قائمة حسب عدد أفراد الأسرة</h2></div>';
    html += '<table class="print-table"><thead><tr><th>#</th><th>رقم الجرد</th><th>رب الأسرة</th><th>المحافظة</th><th>عدد الأفراد</th></tr></thead><tbody>';
    for (var k = 0; k < sorted.length; k++) {
      var rr = sorted[k];
      var rname = (rr.head && rr.head.name) ? rr.head.name : '—';
      var total2 = (rr.familyCount || 0) + (rr.wives ? rr.wives.length : 0);
      html += '<tr><td>' + (k + 1) + '</td><td>' + escapeHtml(rr.inventoryStart || '—') + '</td><td>' + escapeHtml(rname) + '</td><td>' + escapeHtml(rr.governorate) + '</td><td>' + total2 + '</td></tr>';
    }
    html += '</tbody></table><div class="print-footer">' + footerText + '</div><div class="print-meta">تاريخ الطباعة: ' + new Date().toLocaleString('ar-IQ') + '</div></div>';
  } else {
    for (var n = 0; n < filtered.length; n++) {
      var rec = filtered[n];
      var h = rec.head || {};
      html += '<div class="print-page"><div class="print-header"><h1>🏛️ استمارة المهندس أزهر الإلكترونية</h1><h2>استمارة جرد أسرة</h2></div>';
      html += '<div class="print-section"><h3>📋 معلومات الاستمارة</h3><div class="print-row">';
      html += '<div class="item"><strong>اسم المختار:</strong> ' + escapeHtml(rec.surveyorName || '—') + '</div>';
      html += '<div class="item"><strong>رقم بدء الجرد:</strong> ' + escapeHtml(rec.inventoryStart || '—') + '</div>';
      html += '<div class="item"><strong>المحافظة:</strong> ' + escapeHtml(rec.governorate) + '</div>';
      html += '<div class="item"><strong>القضاء:</strong> ' + escapeHtml(rec.district || '—') + '</div>';
      html += '<div class="item"><strong>الناحية:</strong> ' + escapeHtml(rec.subdistrict || '—') + '</div>';
      html += '<div class="item"><strong>المنطقة:</strong> ' + escapeHtml(rec.area || '—') + '</div>';
      html += '<div class="item"><strong>الحي:</strong> ' + escapeHtml(rec.neighborhood || '—') + '</div>';
      html += '</div></div>';
      html += '<div class="print-section"><h3>🏠 السكن</h3><div class="print-row">';
      html += '<div class="item"><strong>النوع:</strong> ' + escapeHtml(rec.housingType || '—') + '</div>';
      if (rec.housingType === 'سكني') {
        html += '<div class="item"><strong>الحيازة:</strong> ' + escapeHtml(rec.residentialType || '—') + '</div>';
        html += '<div class="item"><strong>بطاقة السكن:</strong> ' + escapeHtml(rec.housingCard || '—') + '</div>';
        html += '<div class="item"><strong>التمويني:</strong> ' + escapeHtml(rec.rationNumber || '—') + '</div>';
      } else if (rec.housingType === 'تجاري') {
        html += '<div class="item"><strong>الحيازة:</strong> ' + escapeHtml(rec.commercialType || '—') + '</div>';
        html += '<div class="item"><strong>صاحب الملك:</strong> ' + escapeHtml(rec.ownerName || '—') + '</div>';
        html += '<div class="item"><strong>هوية المالك:</strong> ' + escapeHtml(rec.ownerId || '—') + '</div>';
        html += '<div class="item"><strong>المستأجر:</strong> ' + escapeHtml(rec.tenantName || '—') + '</div>';
        html += '<div class="item"><strong>هوية المستأجر:</strong> ' + escapeHtml(rec.tenantId || '—') + '</div>';
        html += '<div class="item"><strong>نوع الموقع:</strong> ' + escapeHtml(rec.siteType || '—') + '</div>';
        html += '<div class="item"><strong>التصنيف:</strong> ' + escapeHtml(rec.siteSubtype || '—') + '</div>';
      }
      html += '</div></div>';
      html += '<div class="print-section"><h3>👤 رب الأسرة</h3><div class="print-row">';
      html += '<div class="item"><strong>الاسم:</strong> ' + escapeHtml(h.name || '—') + '</div>';
      html += '<div class="item"><strong>الحالة الاجتماعية:</strong> ' + escapeHtml(h.marital || '—') + '</div>';
      html += '<div class="item"><strong>اسم الأم:</strong> ' + escapeHtml(h.motherName || '—') + '</div>';
      html += '<div class="item"><strong>حالة الأب:</strong> ' + escapeHtml(h.fatherStatus || '—') + '</div>';
      html += '<div class="item"><strong>حالة الأم:</strong> ' + escapeHtml(h.motherStatus || '—') + '</div>';
      html += '<div class="item"><strong>تاريخ التولد:</strong> ' + escapeHtml(h.birthDate || '—') + '</div>';
      html += '<div class="item"><strong>التحصيل:</strong> ' + escapeHtml(h.education || '—') + '</div>';
      html += '<div class="item"><strong>المهنة:</strong> ' + escapeHtml(h.occupation || '—') + '</div>';
      html += '<div class="item"><strong>اليتم:</strong> ' + escapeHtml(h.orphan || '—') + (h.orphanKind ? ' - ' + escapeHtml(h.orphanKind) : '') + '</div>';
      html += '<div class="item"><strong>البطاقة الموحدة:</strong> ' + escapeHtml(h.cardInfo || '—') + '</div>';
      html += '<div class="item"><strong>الهاتف:</strong> ' + escapeHtml(h.phone || '—') + '</div>';
      html += '</div></div>';

      if (rec.wives && rec.wives.length) {
        html += '<div class="print-section"><h3>💍 الزوجات الحاليات (' + rec.wives.length + ')</h3>';
        html += '<table class="print-table"><thead><tr><th>#</th><th>الاسم</th><th>اسم الأم</th><th>تاريخ التولد</th><th>التحصيل</th><th>المهنة</th></tr></thead><tbody>';
        for (var wi = 0; wi < rec.wives.length; wi++) {
          var w = rec.wives[wi];
          html += '<tr><td>' + (wi + 1) + '</td><td>' + escapeHtml(w.name || '—') + '</td><td>' + escapeHtml(w.motherName || '—') + '</td><td>' + escapeHtml(w.birthDate || '—') + '</td><td>' + escapeHtml(w.education || '—') + '</td><td>' + escapeHtml(w.occupation || '—') + '</td></tr>';
        }
        html += '</tbody></table></div>';
      }
      if (rec.formerWives && rec.formerWives.length) {
        html += '<div class="print-section"><h3>💔 الزوجات السابقات (' + rec.formerWives.length + ')</h3>';
        html += '<table class="print-table"><thead><tr><th>#</th><th>الاسم</th><th>الحالة</th></tr></thead><tbody>';
        for (var fi = 0; fi < rec.formerWives.length; fi++) {
          var fw = rec.formerWives[fi];
          html += '<tr><td>' + (fi + 1) + '</td><td>' + escapeHtml(fw.name || '—') + '</td><td>' + escapeHtml(fw.status || '—') + '</td></tr>';
        }
        html += '</tbody></table></div>';
      }
      if (rec.members && rec.members.length) {
        html += '<div class="print-section"><h3>👨‍👩‍👧‍👦 أفراد الأسرة (' + rec.members.length + ')</h3>';
        html += '<table class="print-table"><thead><tr><th>#</th><th>الاسم</th><th>القرابة</th><th>اسم الأم</th><th>التولد</th><th>التحصيل</th><th>المهنة</th><th>اليتم</th></tr></thead><tbody>';
        for (var mi = 0; mi < rec.members.length; mi++) {
          var m = rec.members[mi];
          html += '<tr><td>' + (mi + 1) + '</td><td>' + escapeHtml(m.name || '—') + '</td><td>' + escapeHtml(m.relation || '—') + '</td><td>' + escapeHtml(m.motherName || '—') + '</td><td>' + escapeHtml(m.birthDate || '—') + '</td><td>' + escapeHtml(m.education || '—') + '</td><td>' + escapeHtml(m.occupation || '—') + '</td><td>' + escapeHtml(m.orphan || 'لا') + (m.orphanKind ? ' - ' + escapeHtml(m.orphanKind) : '') + '</td></tr>';
        }
        html += '</tbody></table></div>';
      }
      if (rec.notes) html += '<div class="print-section"><h3>📝 ملاحظات</h3><p style="font-size:11px">' + escapeHtml(rec.notes) + '</p></div>';
      html += '<div class="print-footer">' + footerText + '</div>';
      html += '<div class="print-meta">تاريخ الطباعة: ' + new Date().toLocaleString('ar-IQ') + '</div></div>';
    }
  }
  printArea.innerHTML = html;
  closeModal('printModal');
  setTimeout(function(){ window.print(); }, 400);
}

// ====== بدء التشغيل + Service Worker ======
window.onload = function(){
  try {
    var s = localStorage.getItem('azhar_surveyor');
    if (s) document.getElementById('surveyorName').value = s;
  } catch(e){}
  var labels = document.querySelectorAll('.tri-toggle label');
  for (var i = 0; i < labels.length; i++) {
    (function(lbl){
      var inp = lbl.querySelector('input');
      if (!inp) return;
      if (inp.checked) lbl.classList.add('active');
      inp.addEventListener('change', function(){
        var sibs = lbl.parentNode.querySelectorAll('label');
        for (var j = 0; j < sibs.length; j++) sibs[j].classList.remove('active');
        if (inp.checked) lbl.classList.add('active');
      });
    })(labels[i]);
  }
  document.addEventListener('input', updateProgress);
  document.addEventListener('change', updateProgress);
  updateProgress();
};

if ('serviceWorker' in navigator) {
  window.addEventListener('load', function(){
    navigator.serviceWorker.register('./sw.js').catch(function(){});
  });
}
</script>
</body>
</html>
  
